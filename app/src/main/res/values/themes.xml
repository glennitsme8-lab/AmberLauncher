<resources>
    <style name="Theme.NuxLauncher" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:statusBarColor">#FFF6E5</item>
        <item name="android:navigationBarColor">#FFF6E5</item>
        <item name="android:windowBackground">#FFF6E5</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Dialog (Compose Dialog/AlertDialog ikut memakai ini) muncul dan hilang tanpa animasi jendela. -->
        <item name="android:dialogTheme">@style/Theme.NuxLauncher.Dialog</item>
    </style>

    <style name="Theme.NuxLauncher.Dialog" parent="android:Theme.Material.Light.Dialog">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Layar penuh untuk mesin Horizon (nilai sama dengan tema bawaan Horizon). -->
    <style name="HorizonGameTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">#9a86ff</item>
    </style>
</resources>
